{
  "name": "contract-guardian-web",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Gestão de contratos corporativos em React, TypeScript e Tailwind CSS.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "start": "npm run dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": { "react": "19.3.1", "react-dom": "19.3.1" },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^27.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
